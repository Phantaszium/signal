# ---------------------------------------------------------------------------
# PaperPuffin environment variables. Copy to .env.local for local development.
# .env.local is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project Settings → API. The publishable key is safe in the browser; the
# secret key bypasses row level security and must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Claude (required) ------------------------------------------------------
# console.anthropic.com → API keys. Used for every relevance assessment.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. claude-sonnet-5-5 costs about half.
SIGNAL_MODEL=
# Optional. Records assessed per user per scheduled check (default 25), per
# manual "Check now" (default 12), and extra for each new topic's first 30-day
# look-back (default 15). These are the main cost levers.
SIGNAL_NIGHTLY_CANDIDATES=
SIGNAL_ON_DEMAND_CANDIDATES=
SIGNAL_BACKFILL_CANDIDATES=
# Optional. "Explain for my research" requests per user per day (default 25).
PAPERPUFFIN_DAILY_EXPLAINS=

# --- Email (required for digest and alert emails) ---------------------------
# resend.com → API keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="PaperPuffin <briefing@your-domain.com>"

# --- App --------------------------------------------------------------------
# Public URL used in emailed links. On Vercel the production URL is detected
# automatically; set this if you use a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails that can open /admin and are always approved.
ADMIN_EMAILS=
# Any long random string. Vercel Cron sends it to the /api/cron routes.
CRON_SECRET=

# --- PubMed (optional) ------------------------------------------------------
# Raises the NCBI rate limit from 3 to 10 requests/sec.
NCBI_API_KEY=
NCBI_TOOL_EMAIL=
