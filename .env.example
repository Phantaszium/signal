# ---------------------------------------------------------------------------
# Signal — environment variables
#
# NOTHING HERE IS REQUIRED. With no environment variables set at all, the app
# builds, deploys and runs the full demo on its bundled seed corpus. Deploy
# first, add these later only if you want the live PubMed path.
#
# Copy to .env.local for local development:   cp .env.example .env.local
# .env.local is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# OPTIONAL — raises the NCBI E-utilities rate limit from 3 to 10 requests/sec.
# PubMed works without it; a key mainly helps because serverless hosts share
# outbound IPs, so the unauthenticated per-IP limit is easier to hit.
# Free from: https://account.ncbi.nlm.nih.gov/settings/
# SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_.
NCBI_API_KEY=

# OPTIONAL — contact address NCBI asks API consumers to identify themselves
# with. Sent as the `email` parameter alongside `tool=signal`. Recommended if
# you enable live PubMed in production.
# SERVER-SIDE ONLY.
NCBI_TOOL_EMAIL=
